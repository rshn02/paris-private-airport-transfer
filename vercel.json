{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-public.cjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/airport-transfer",
      "destination": "/airport",
      "permanent": true
    },
    {
      "source": "/disneyland-transfer",
      "destination": "/disneyland",
      "permanent": true
    },
    {
      "source": "/long-distance-transfer",
      "destination": "/long-distance",
      "permanent": true
    },
    {
      "source": "/hourly-service",
      "destination": "/hourly",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/airport",
      "destination": "/airport-transfer"
    },
    {
      "source": "/disneyland",
      "destination": "/disneyland-transfer"
    },
    {
      "source": "/long-distance",
      "destination": "/long-distance-transfer"
    },
    {
      "source": "/hourly",
      "destination": "/hourly-service"
    }
  ]
}
